{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=FluxifyDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "USE_ENVIRONMENT_VARIABLE_OR_USER_SECRETS_MINIMUM_32_CHARACTERS",
    "Issuer": "FluxifyAPI",
    "Audience": "FluxifyClient",
    "ExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-frontend-domain.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
